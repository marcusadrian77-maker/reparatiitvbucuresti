---
import Base from '../layouts/Base.astro';
import Cifre from './Cifre.astro';
import Cta from '../components/Cta.astro';
import { u, SITE } from '../data/site';
import { BRANDURI, LISTA_BRANDURI } from '../data/branduri';
import { PRETURI, PASI } from '../data/continut-loc';
import { SECTOARE } from '../data/sectoare';
import { hubModele, modeleMarca, MODELE_MARCA } from '../data/hub';

const { cheie } = Astro.props;
const B = BRANDURI[cheie];
const canonical = new URL(Astro.url.pathname, SITE.domeniu).href;
const altele = LISTA_BRANDURI.filter(x => x.slug !== B.slug);
const hub = hubModele(B.slug);
const modele = MODELE_MARCA[B.slug] ? modeleMarca(MODELE_MARCA[B.slug]) : [];

const schemaExtra = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      serviceType: `Reparații televizoare ${B.nume}`,
      name: `Reparații TV ${B.nume} București`,
      url: canonical,
      description: B.descriere,
      brand: { '@type': 'Brand', name: B.nume },
      areaServed: [{ '@type': 'City', name: 'București' }, { '@type': 'AdministrativeArea', name: 'Județul Ilfov' }],
      provider: { '@id': 'https://www.reparatiitvbucuresti.ro/#business' },
      offers: { '@type': 'Offer', priceCurrency: 'RON', url: SITE.domeniu + '/preturi-reparatii-tv/' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Acasă', item: SITE.domeniu + '/' },
        { '@type': 'ListItem', position: 2, name: `Reparații TV ${B.nume}`, item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: B.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};
---
<Base title={B.titlu} description={B.descriere} schemaExtra={schemaExtra}>
  <section class="hero-img"><div class="wrap">
    <span class="badge">{B.nume} · La domiciliu · Garanție 6–12 luni</span>
    <h1>Reparații Televizoare {B.nume} București</h1>
    <p class="lead">Service TV {B.nume} la domiciliu în București și Ilfov. Diagnosticare și deplasare gratuite, reparație pe loc, plătiți doar dacă televizorul funcționează.</p>
  </div></section>
  <Cifre />

  <section class="sec"><div class="wrap">
    
    <p>{B.intro}</p>
    <p>{B.context}</p>

    <h2>Defecțiuni {B.nume} frecvente și cum le rezolvăm</h2>
    <div class="grid g2">{B.defecte.map(d => <div class="card"><h3>{d[0]}</h3><p>{d[1]}</p></div>)}</div>

    <h2>{B.serii}</h2>
    <ul class="checks">{B.serii_lista.map(s => <li>{s}</li>)}</ul>

    {cheie === 'sony' && (
      <div>
        <h2>Din atelier: Sony KD-55XE8096 cu memoria internă defectă</h2>
        <p>Un caz recent, tipic pentru Bravia cu Android TV trecute de câțiva ani: un KD-55XE8096 fabricat în 2018, cu memoria internă (eMMC) cedată. La modelele Sony din această generație e defectul pe care îl întâlnim cel mai des și se vede de obicei ca blocare la siglă sau reporniri în buclă. Nu se rezolvă prin resetare, pentru că memoria însăși e uzată.</p>
        <p>Pentru o astfel de lucrare aparatul vine în atelier: desfacem capacul din spate, scoatem placa de bază, înlocuim cipul de memorie și scriem din nou sistemul de operare. Apoi televizorul stă câteva ore în test pe banc, cu imagine, sunet și aplicații, înainte să îl aducem înapoi. Transportul îl facem noi, fără cost.</p>
        <div class="grid g3" style="gap:14px;margin:14px 0 6px">
        <figure style="margin:0"><img src="/img/sony-kd-55xe8096-desfacut.webp" alt="Televizor Sony KD-55XE8096 desfăcut pe bancul de lucru, cu sursa și placa de bază la vedere" width="1400" height="1050" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:10px;display:block" /><figcaption style="font-size:13.5px;color:#5a6b80;margin-top:6px">Aparatul desfăcut: sursa în stânga, placa de bază în dreapta.</figcaption></figure>
        <figure style="margin:0"><img src="/img/sony-kd-55xe8096-placa-de-baza.webp" alt="Placa de bază a televizorului Sony KD-55XE8096, pe care se află memoria eMMC" width="1400" height="1050" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:10px;display:block" /><figcaption style="font-size:13.5px;color:#5a6b80;margin-top:6px">Placa de bază, unde se află memoria eMMC înlocuită.</figcaption></figure>
        <figure style="margin:0"><img src="/img/televizor-sony-in-test-atelier.webp" alt="Televizor Sony Bravia în test pe banc după înlocuirea memoriei eMMC" width="1400" height="1050" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:10px;display:block" /><figcaption style="font-size:13.5px;color:#5a6b80;margin-top:6px">După reparație, în test pe banc înainte de predare.</figcaption></figure>
        </div>
      </div>
    )}

    {B.sectiuni && B.sectiuni.map(([titlu, paragrafe]) => (
      <div>
        <h2>{titlu}</h2>
        {paragrafe.map(p => <p set:html={p} />)}
      </div>
    ))}

    <h2>Cum decurge intervenția</h2>
    <ol>{PASI.map(p => <li><strong>{p[0]}.</strong> {p[1]}</li>)}</ol>

    <h2>Prețuri orientative pentru televizoare {B.nume}</h2>
    <table style="width:100%;border-collapse:collapse;margin:12px 0">
      <tbody>
        {PRETURI.map(p => (
          <tr style="border-bottom:1px solid #e6ecf4">
            <td style="padding:9px 6px">{p[0]}</td>
            <td style="padding:9px 6px;text-align:right;white-space:nowrap"><strong>{p[1]}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p style="font-size:14px;color:#5a6b80;margin-top:-4px">Prețurile pot varia în funcție de diagonală și de model. Valoarea exactă o aflați după diagnosticare, care este gratuită.</p>
    <p style="font-size:14px;color:#5a6b80;margin-top:-4px">Prețurile includ manopera și sunt aceleași pentru toate mărcile. Valoarea exactă o aflați după diagnosticarea gratuită. Vedeți <a href={u('preturi-reparatii-tv/')}>lista completă de prețuri</a>.</p>

    <h2>Unde ne deplasăm</h2>
    <p>Reparăm televizoare {B.nume} la domiciliu în toate sectoarele Bucureștiului și în localitățile din Ilfov, fără taxă de deplasare:</p>
    <div class="grid g3" style="gap:4px 18px">
      {[1, 2, 3, 4, 5, 6].map(n => <a href={u(SECTOARE[n].slug + '/')} style="font-size:14.5px;padding:3px 0;display:block">Reparații TV Sector {n}</a>)}
    </div>

    <h2>Întrebări frecvente – televizoare {B.nume}</h2>
    {B.faq.map(([q, a]) => (
      <div style="margin:0 0 14px">
        <h3 style="margin:0 0 4px;font-size:17px">{q}</h3>
        <p style="margin:0">{a}</p>
      </div>
    ))}

    {modele.length > 0 && (
      <div>
        <h2>Modele {B.nume} cu pagină dedicată</h2>
        <p>Pentru fiecare dintre modelele de mai jos am scris o pagină separată, cu specificațiile aparatului, defecțiunile tipice ale generației din care face parte și prețurile orientative pentru diagonala respectivă.{hub ? ' Lista este disponibilă și pe pagina ' : ''}{hub && <a href={u(hub.slug + '/')}>{hub.titlu}</a>}{hub ? '.' : ''}</p>
        <div class="grid g3" style="gap:4px 18px">
          {modele.map(m => <a href={u(m.s + '/')} style="font-size:14px;padding:3px 0;display:block">{m.t}</a>)}
        </div>
      </div>
    )}

    <h2>Alte mărci pe care le reparăm</h2>
    <div class="grid g3" style="gap:4px 18px">
      {altele.map(x => <a href={u(x.slug + '/')} style="font-size:14.5px;padding:3px 0;display:block">Reparații TV {x.nume}</a>)}
    </div>

    <Cta titlu={`Televizor ${B.nume} defect? Sunați-ne acum!`} />
  </div></section>
</Base>
