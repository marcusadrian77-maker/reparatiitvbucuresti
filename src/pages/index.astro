---
import Base from '../layouts/Base.astro';
import Cifre from '../components/Cifre.astro';
import Cta from '../components/Cta.astro';
import Testimoniale from '../components/Testimoniale.astro';
import { SITE, u } from '../data/site';
import { SECTOARE } from '../data/sectoare';
import { LISTA_BRANDURI } from '../data/branduri';
import { LOCATII } from '../data/locatii';
import { PRETURI } from '../data/continut-loc';
import { numeLoc } from '../data/strazi';

const ilfov = LOCATII.map(([sl, nm]) => ({ sl, ...numeLoc(sl, nm) }))
  .filter(x => x.kind === 'ilfov' && x.sl !== 'ilfov')
  .sort((a, b) => a.full.localeCompare(b.full, 'ro'));
const title = 'Reparații Televizoare București – Service TV la Domiciliu';
const description = 'Reparații televizoare la domiciliu în București și Ilfov: LED, OLED, QLED, Smart TV, orice marcă. Deplasare și diagnosticare gratuite, garanție 6–12 luni.';
const servicii = [
  { i: '⚡', t: 'TV nu pornește', d: 'Reparăm sursa de alimentare, placa principală și rescriem memoria eMMC cu programator special.' },
  { i: '💡', t: 'Backlight / ecran întunecat', d: 'Înlocuim baretele LED, driverele și invertoarele pentru imagine clară.' },
  { i: '🖼️', t: 'Linii sau pete pe ecran', d: 'Diagnoză și reparație placă T-CON sau panou LED/OLED/QLED.' },
  { i: '🔊', t: 'Probleme de sunet', d: 'Reparăm circuitul audio, amplificatorul și difuzoarele.' },
  { i: '📡', t: 'Smart TV & software', d: 'Update firmware, resetare, conectare Wi-Fi și aplicații.' },
  { i: '🔧', t: 'Curățare & mentenanță', d: 'Schimb pastă termică, curățare internă, înlocuire condensatori devalorizați.' },
];
const dece = [
  'Diagnosticare gratuită la domiciliu',
  'Deplasare gratuită în București și Ilfov',
  'Plătiți doar dacă televizorul funcționează',
  'Piese originale sau compatibile de calitate',
  'Garanție 6–12 luni la intervenție',
  'Peste 10 ani experiență, tehnicieni certificați',
];
const faq = [
  { q: 'Cât costă diagnosticarea unui televizor?', a: 'Diagnosticarea și deplasarea sunt gratuite în București și Ilfov. Plătiți doar dacă televizorul funcționează după reparație.' },
  { q: 'În cât timp ajungeți la domiciliu?', a: 'De regulă intervenim în aceeași zi în București și împrejurimi, în funcție de programul disponibil. Sunați la 0765.461.357 pentru o programare rapidă.' },
  { q: 'Ce mărci de televizoare reparați?', a: 'Reparăm orice marcă: Samsung, LG, Sony, Philips, Panasonic, Horizon și altele, televizoare LED, OLED, QLED și Smart TV.' },
  { q: 'Ce garanție oferiți la reparație?', a: 'Oferim garanție de 6–12 luni la intervenție, în funcție de tipul reparației și de piesele folosite.' },
  { q: 'În ce zone vă deplasați?', a: 'Ne deplasăm gratuit în toate cele 6 sectoare ale Bucureștiului și în localitățile din Ilfov: Voluntari, Popești-Leordeni, Otopeni, Pantelimon, Bragadiru, Chiajna, Buftea, Măgurele și altele.' },
  { q: 'Televizorul nu pornește deloc. Se poate repara?', a: 'Da. În cele mai multe cazuri reparăm sursa de alimentare, placa principală sau rescriem memoria eMMC cu programator special. Diagnosticul gratuit stabilește exact cauza.' },
  { q: 'Cât costă o reparație de televizor?', a: 'Depinde de piesa înlocuită. O reparație de sursă costă între 230 și 530 de lei, o înlocuire de barete LED între 150 și 420 de lei, iar un service software între 80 și 230 de lei. Diagnosticarea, prin care aflați prețul exact, este gratuită.' },
  { q: 'Reparați acasă sau luați televizorul?', a: 'În peste 90% din cazuri reparăm la domiciliu, în fața dumneavoastră. Doar lucrările care cer echipament de atelier necesită transportul aparatului, iar în acel caz vă spunem înainte.' },
  { q: 'Ce se întâmplă dacă televizorul nu poate fi reparat?', a: 'Nu plătiți nimic. Diagnosticarea rămâne gratuită indiferent de rezultat, iar dacă reparația nu merită economic vă spunem direct, fără să insistăm.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={title} description={description} schemaExtra={faqSchema}>
  <section class="hero-img">
    <div class="wrap">
      <span class="badge">Service TV profesional · Garanție 6–12 luni</span>
      <h1>Reparații Televizoare București — Service TV la Domiciliu</h1>
      <p class="lead">Reparații TV la domiciliu pentru televizoare LED, OLED, QLED și Smart TV, orice marcă. Diagnosticare și deplasare gratuită în toate sectoarele. Intervenție rapidă, de regulă în aceeași zi.</p>
      <div class="pills">
        <span>LED · OLED · QLED</span><span>Samsung · LG · Sony · Philips</span><span>La domiciliu</span>
      </div>
      <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
      <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
    </div>
  </section>
  <Cifre />

  <section class="sec">
    <div class="wrap">
      <h2>Ce defecțiuni reparăm</h2>
      <div class="grid g3">
        {servicii.map(s => (
          <div class="card"><div class="ico">{s.i}</div><h3>{s.t}</h3><p>{s.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>De ce să ne alegeți</h2>
      <ul class="checks">{dece.map(x => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Cum lucrăm</h2>
      <p>Venim la dumneavoastră acasă cu trusa completă — stație de lipit, osciloscop, sursă de laborator pentru testarea baretelor LED și programator de memorie eMMC — plus un stoc de piese uzuale în mașină. Din acest motiv, în cele mai multe cazuri reparația se termină la prima vizită, fără ca televizorul să părăsească locuința.</p>
      <p>Diagnosticarea o facem în fața dumneavoastră: deschidem aparatul, măsurăm și vă arătăm componenta defectă. Abia apoi vorbim despre preț, iar suma comunicată este cea finală. Dacă nu vă convine sau dacă reparația nu merită economic, vă spunem direct și nu plătiți nimic.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Ce înseamnă concret „la domiciliu”</h2>
      <figure style="margin:14px auto 18px;max-width:760px"><img src="/img/atelier-reparatii-tv-bucuresti.webp" alt="Atelierul de reparații TV din Militari, București, cu bancuri de lucru și televizoare în test" width="1400" height="1050" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:10px;display:block" /><figcaption style="font-size:14px;color:#5a6b80;margin-top:6px">Atelierul nostru din Militari — aici ajung aparatele care au nevoie de lucru la placă sau de test de durată.</figcaption></figure>
      <p>Pentru majoritatea defectelor nu e nevoie ca televizorul să plece de acasă. Tehnicianul vine cu piesele cele mai probabile pentru modelul dumneavoastră — sursă, benzi LED, placă T-CON, condensatori — alese după codul de pe etichetă pe care ni-l dați la telefon. De aceea în cele mai multe cazuri reparația se încheie la prima vizită.</p>
      <p>Aparatul se lucrează întins pe spate, pe o masă sau pe un pat, cu o pătură sub panou. Durează de obicei între o oră și două. La final pornim televizorul pe canale, pe HDMI și în aplicații, și îl lăsăm să meargă câteva minute sub ochii dumneavoastră înainte să plecăm.</p>
      <p>Există și situații în care televizorul ajunge la noi în atelierul din Militari: memoria internă (eMMC) care trebuie înlocuită și programată, reparații la nivel de componentă pe placa de bază, sub microscop, sau un defect intermitent care cere câteva ore de test. Atunci îl luăm și îl aducem înapoi noi, fără cost de transport. Detalii despre atelier găsiți la <a href="/cum-ajungeti-la-atelier/">cum ajungeți la atelier</a>.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Cât costă o reparație TV</h2>
      <p>Intervalele de mai jos acoperă marea majoritate a intervențiilor pe care le facem într-o lună obișnuită. Includ manopera și piesa. Prețul exact îl aflați după diagnosticare, care este gratuită și se face în fața dumneavoastră.</p>
      <table style="width:100%;border-collapse:collapse;margin:12px 0">
        <tbody>
          {PRETURI.map(x => (
            <tr style="border-bottom:1px solid #e6ecf4">
              <td style="padding:9px 6px">{x[0]}</td>
              <td style="padding:9px 6px;text-align:right;white-space:nowrap"><strong>{x[1]}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:14px;color:#5a6b80;margin-top:-4px">Grila completă, pe tipuri de defect și diagonale, e pe pagina de <a href={u('preturi-reparatii-tv/')}>prețuri reparații TV</a>.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Când merită reparat un televizor și când nu</h2>
      <p>Regula pe care o aplicăm de ani de zile: dacă panoul e bun, reparația aproape întotdeauna merită. Panoul — sticla propriu-zisă — este 60–70% din valoarea unui televizor. Tot ce se află în spatele lui (sursa de alimentare, placa principală, placa T-CON, baretele LED, circuitul audio) sunt piese care se repară sau se înlocuiesc cu o fracțiune din prețul unui aparat nou.</p>
      <p>De aceea un televizor de 55 de inch care nu mai pornește merită reparat chiar dacă are șase-șapte ani: sursa costă 230–530 de lei, iar aparatul echivalent nou costă de zece ori mai mult. La fel, un ecran care s-a întunecat treptat înseamnă aproape sigur barete LED obosite, nu panou mort — o intervenție de 150–420 de lei.</p>
      <p>Vă spunem deschis și când nu merită. Un panou crăpat sau lovit nu se repară, se înlocuiește, iar panoul nou costă mai mult decât un televizor nou de aceeași diagonală. Același lucru la aparatele mici, sub 32 de inch, unde orice reparație de placă se apropie de prețul unui model nou. În cazurile astea vă spunem la telefon, înainte să ne deplasăm, ca să nu pierdeți timpul.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Ce se strică cel mai des, pe mărci</h2>
      <figure style="margin:14px auto 18px;max-width:760px"><img src="/img/televizor-sony-in-test-atelier.webp" alt="Televizor Sony Bravia în test după reparație, pe bancul de lucru din atelier" width="1400" height="1050" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:10px;display:block" /><figcaption style="font-size:14px;color:#5a6b80;margin-top:6px">Sony Bravia în test pe banc, după înlocuirea memoriei interne (eMMC).</figcaption></figure>
      <p><strong>Samsung.</strong> Pe seriile LED din ultimii ani, iluminarea din spate e defectul numărul unu: sunetul merge, imaginea e neagră sau foarte întunecată. Urmează sursa, mai ales după variații de tensiune. Mai multe pe pagina de <a href="/reparatii-televizoare-samsung/">reparații televizoare Samsung</a>.</p>
      <p><strong>LG.</strong> Benzile LED de pe modelele 2016–2021 cedează pe rând, iar primul semn e o tentă albăstruie sau pete mai luminoase pe fundalurile albe. La OLED-urile LG verificăm întâi sursa și placa T-CON, pentru că panoul e scump. Vezi <a href="/reparatii-televizoare-lg/">reparații televizoare LG</a>.</p>
      <p><strong>Sony.</strong> Modelele Bravia cu Android TV ajung des la noi blocate la siglă sau cu reporniri în buclă — de obicei e memoria internă, uzată după 6–8 ani. Ledul roșu care clipește într-un anumit ritm ne arată zona defectului. Detalii la <a href="/reparatii-tv-sony/">reparații TV Sony</a>.</p>
      <p><strong>Philips.</strong> Pe lângă iluminare și sursă, vedem des Ambilight-ul stins pe o parte și televizoare Android care rămân la pornire după o actualizare. Pagina dedicată: <a href="/reparatii-televizoare-philips/">reparații televizoare Philips</a>.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Mărci pe care le reparăm</h2>
      <p>Pentru mărcile cu care lucrăm cel mai des avem pagini dedicate, cu seriile de modele și defecțiunile specifice fiecăreia:</p>
      <div class="grid g3" style="gap:4px 18px">
        {LISTA_BRANDURI.map(b => <a href={u(b.slug + '/')} style="font-size:15px;padding:4px 0;display:block">Reparații TV {b.nume}</a>)}
      </div>
      <p>Reparăm și televizoare TCL, Hisense, Sharp, Toshiba, Vestel, Grundig, Allview, Star-Light și practic orice altă marcă de pe piața din România.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Cât de repede ajungem, pe sectoare</h2>
      <p>Atelierul e pe Str. Moinești, în Militari, deci plecăm din vestul orașului. În <a href="/reparatii-tv-sector-6/">Sectorul 6</a> și în <a href="/reparatii-tv-sector-5/">Sectorul 5</a> ajungem cel mai repede, de obicei în aceeași zi în care sunați. Pentru <a href="/reparatii-tv-sector-1/">Sectorul 1</a> și <a href="/reparatii-tv-sector-2/">Sectorul 2</a> stabilim o oră la telefon, iar în <a href="/reparatii-tv-sector-3/">Sectorul 3</a> și <a href="/reparatii-tv-sector-4/">Sectorul 4</a>, unde traversăm tot orașul, vă dăm un interval de două ore pe care îl respectăm.</p>
      <p>Ne deplasăm și în localitățile din <a href="/ilfov/">Ilfov</a> — Voluntari, Otopeni, Chiajna, Bragadiru, Popești-Leordeni și celelalte. Deplasarea și diagnosticul sunt gratuite peste tot, iar prețul îl aflați înainte să începem lucrul.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Zone deservite</h2>
      <p>Ne deplasăm gratuit în toate cele șase sectoare ale Bucureștiului:</p>
      <div class="grid g3" style="gap:4px 18px">
        {[1, 2, 3, 4, 5, 6].map(n => <a href={u(SECTOARE[n].slug + '/')} style="font-size:15px;padding:4px 0;display:block">Reparații TV Sector {n}</a>)}
      </div>
      <p style="margin-top:14px">Și în localitățile din Ilfov din jurul Capitalei:</p>
      <div class="grid g3" style="gap:4px 18px">
        {ilfov.map(x => <a href={u(x.sl + '/')} style="font-size:14px;padding:3px 0;display:block">Reparații TV {x.full}</a>)}
      </div>
      <p style="margin-top:10px">Lista completă a străzilor acoperite se află pe pagina de <a href={u('zone-deservite-strazi-bucuresti/')}>zone deservite</a>.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <Testimoniale />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Înainte să ne sunați</h2>
      <p>Patru informații care scurtează reparația, pentru că ne permit să venim din prima cu piesa potrivită:</p>
      <ul><li><strong>modelul exact</strong> de pe eticheta din spatele televizorului (de exemplu UE55AU7172, 55UM7100 sau KD-55XE8096);</li><li><strong>ce se vede și ce se aude</strong> — imagine neagră cu sunet, dungi, pete, repornire, nimic;</li><li><strong>de când</strong> și dacă a apărut brusc, după o furtună sau o pană de curent;</li><li><strong>ledul din față</strong> — stă aprins, stins sau clipește, și de câte ori.</li></ul>
      <p>Dacă vreți să vă faceți o idee înainte, ghidurile noastre explică situațiile cele mai frecvente: <a href="/televizorul-se-aude-dar-nu-se-vede/">televizorul se aude, dar nu se vede</a>, <a href="/televizor-trasnit/">televizor trăsnit</a>, <a href="/inlocuire-leduri-tv/">înlocuirea ledurilor</a> și <a href="/cat-costa-reparatia-unui-televizor/">cât costă reparația unui televizor</a>.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Întrebări frecvente</h2>
      {faq.map(f => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <Cta />
    </div>
  </section>
</Base>

<style>
  .faq-item{border:1px solid #e3e8f0;border-radius:10px;margin:0 0 10px;padding:0 16px;background:#fff}
  .faq-item summary{cursor:pointer;font-weight:600;color:#14365d;padding:14px 0;list-style:none}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-item summary::after{content:'+';float:right;color:#0a6ebd;font-weight:700}
  .faq-item[open] summary::after{content:'–'}
  .faq-item p{margin:0 0 14px;color:#444;line-height:1.6}
</style>
